{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "github_repository", "github_branch", "artifact_registry_repository_id", "runtime_account_id", "deployer_account_id", "cloudbuild_staging_bucket_name", "cloud_run_service_name", "initial_image", "labels"],
  "properties": {
    "project": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "github_repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "github_branch": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
    "artifact_registry_repository_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "runtime_account_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$"},
    "deployer_account_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$"},
    "cloudbuild_staging_bucket_name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,61}[a-z0-9]$"},
    "cloud_run_service_name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "initial_image": {"type": "string", "minLength": 1},
    "labels": {"type": "object", "additionalProperties": {"type": "string"}}
  }
}
